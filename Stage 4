def require_file(file_name):
    """
    Check whether a required file exists.

    If the file does not exist, stop the program and display a clear message.
    """

    if not os.path.exists(file_name):
        raise FileNotFoundError(
            f"{file_name} was not found. "
            f"Run the relevant earlier stage before running Stage 4."
        )


def load_csv(file_name):
    """
    Load a CSV file into a pandas DataFrame.
    """

    require_file(file_name)
    return pd.read_csv(file_name)


def load_json(file_name):
    """
    Load a JSON file into a Python dictionary.
    """

    require_file(file_name)

    with open(file_name, "r", encoding="utf-8") as file:
        return json.load(file)


def clean_dataframe_for_mongo(df):
    """
    Convert a pandas DataFrame into a list of dictionaries.

    MongoDB stores data as documents.
    Each DataFrame row becomes one MongoDB document.

    pandas NaN and NaT values are converted to Python None.
    MongoDB will store None as null.
    """

    clean_df = df.copy()

    clean_df = clean_df.astype(object).where(
        pd.notnull(clean_df),
        None
    )

    return clean_df.to_dict(orient="records")


def replace_collection(collection, records):
    """
    Remove old documents and insert the current dataset.

    This prevents duplicate records when the notebook is run more than once.
    """

    collection.delete_many({})

    if records:
        result = collection.insert_many(records)
        inserted_count = len(result.inserted_ids)
    else:
        inserted_count = 0

    return inserted_count


