print("\n[1] STRUCTURED DATA — price history")
print("-" * 70)

print("\n[2] SEMI-STRUCTURED DATA — fundamentals dictionary")
print("-" * 70)
print(json.dumps(fundamentals, indent=2))

try:
    price_history = tkr.history(period="6mo", auto_adjust=True)

    if price_history.empty:
        raise ValueError("Yahoo Finance returned no rows")

    price_history = price_history.reset_index()
    price_history["Date"] = pd.to_datetime(price_history["Date"]).dt.strftime("%Y-%m-%d")

    price_history = price_history.rename(columns={
        "Date": "date",
        "Open": "open",
        "High": "high",
        "Low": "low",
        "Close": "close",
        "Volume": "volume",
        "Dividends": "distribution"
    })

    expected_price_columns = ["date", "open", "high", "low", "close", "volume", "distribution"]

    for col in expected_price_columns:
        if col not in price_history.columns:
            price_history[col] = 0

    price_history = price_history[expected_price_columns]

    info = tkr.info

    fundamentals = {
        "ticker": TICKER,
        "company_name": info.get("longName", COMPANY_NAME),
        "sector": info.get("sector", "Real Estate"),
        "industry": info.get("industry", "REIT - Retail"),
        "market_cap_cad": info.get("marketCap"),
        "previous_close": info.get("previousClose"),
        "trailing_pe": info.get("trailingPE"),
        "eps": info.get("trailingEps"),
        "dividend_yield": info.get("dividendYield"),
        "forward_dividend_rate": info.get("dividendRate"),
        "payout_ratio": info.get("payoutRatio"),
        "beta": info.get("beta"),
        "fifty_two_week_high": info.get("fiftyTwoWeekHigh"),
        "fifty_two_week_low": info.get("fiftyTwoWeekLow"),
        "currency": info.get("currency", "CAD"),
        "exchange": info.get("exchange", "TOR")
    }

    MARKET_SOURCE = "yfinance_live"

    print("SUCCESS — live market data pulled from Yahoo Finance.")
    print(f"Price rows returned: {len(price_history)}")
    print(price_history.head().to_string(index=False))

except Exception as exc:
    print(f"Market data call failed ({exc}). Using placeholder market data.")

    dates = pd.bdate_range(end=pd.Timestamp.today(), periods=126)

    price_history = pd.DataFrame({
        "date": dates.strftime("%Y-%m-%d"),
        "open": [25.10 + (i % 10) * 0.05 for i in range(len(dates))],
        "high": [25.40 + (i % 10) * 0.05 for i in range(len(dates))],
        "low": [24.85 + (i % 10) * 0.05 for i in range(len(dates))],
        "close": [25.20 + (i % 10) * 0.05 for i in range(len(dates))],
        "volume": [200000 + (i % 7) * 15000 for i in range(len(dates))],
        "distribution": [0.0] * len(dates)
