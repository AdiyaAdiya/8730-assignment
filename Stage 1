# STEP 4: Read Annual Report PDF and Extract Tables
# ------------------------------------------------------------------------------

print("\n\n[4] ANNUAL REPORT PDF TABLE EXTRACTION")
print("-" * 70)

PDF_SOURCE = "SmartCentres_Annual_Report_2025_PDF"

extracted_tables = []

try:
    with pdfplumber.open(PDF_FILE) as pdf:
        selected_pages = [2, 3, 10, 11]  # useful annual report pages

        for page_index in selected_pages:
            page = pdf.pages[page_index]
            tables = page.extract_tables()

            for table_number, table in enumerate(tables):
                if table and len(table) > 1:
                    extracted_tables.append({
                        "pdf_page": page_index + 1,
                        "table_number": table_number + 1,
                        "table": table
                    })

    print(f"SUCCESS — {len(extracted_tables)} tables extracted from Annual Report PDF.")

except Exception as exc:
    print(f"PDF table extraction failed ({exc}). Using annual report fallback values.")
    PDF_SOURCE = "manual_fallback_from_annual_report"


