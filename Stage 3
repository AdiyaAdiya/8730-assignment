            va="center"
        )


plt.title(
    "Correlation Matrix: SmartCentres Returns "
    "and Canadian Macroeconomic Factors"
)


plt.colorbar(
    heatmap,
    label="Pearson Correlation"
)


plt.tight_layout()


plt.savefig(
