# =============================================================================
# STAGE 3B — CORRELATION ANALYSIS
# Macroeconomic Factors vs SmartCentres REIT (SRU-UN.TO)
# =============================================================================
#
# PURPOSE:
# Analyze the statistical relationships between SmartCentres monthly returns
# and four Canadian macroeconomic indicators:
#
#   1. Interest Rate
#   2. Inflation Rate
#   3. GDP Growth
#   4. Unemployment Rate
#
# REQUIRED FROM PREVIOUS STAGE 4 CODE:
#
#   interest_monthly
#   inflation_df
#   gdp_df
#   unemployment_df
#
# =============================================================================


# =============================================================================
# 1. IMPORT LIBRARIES
# =============================================================================

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import yfinance as yf
from pathlib import Path


# =============================================================================
# 2. CONFIGURATION
# =============================================================================

START_DATE = "2015-01-01"
END_DATE = pd.Timestamp.today().strftime("%Y-%m-%d")

OUTPUT_DIR = Path("stage4_macro_output")
OUTPUT_DIR.mkdir(exist_ok=True)

TICKER = "SRU-UN.TO"


print("=" * 80)
print("STAGE 4B — MACROECONOMIC CORRELATION ANALYSIS")
print("Target Company: SmartCentres REIT (SRU-UN.TO)")
print("=" * 80)


# =============================================================================
# 3. DOWNLOAD SMARTCENTRES HISTORICAL STOCK DATA
# =============================================================================

print("\nDownloading SmartCentres historical stock data...")


sru = yf.download(
    TICKER,
    start=START_DATE,
    end=END_DATE,
    auto_adjust=True,
    progress=False
)


if sru.empty:

    raise ValueError(
        "No SmartCentres stock data were downloaded."
    )


# Handle possible MultiIndex columns from yfinance

if isinstance(sru.columns, pd.MultiIndex):

    sru.columns = sru.columns.get_level_values(0)


sru = sru.reset_index()


print("\nSmartCentres Data Preview:")

print(
    sru.head()
)


# =============================================================================
# 4. CONVERT DAILY STOCK PRICES TO MONTHLY PRICES
# =============================================================================
#
# We use the last available adjusted closing price of each month.
#
# Monthly return:
#
# (Current Month Price / Previous Month Price - 1) * 100
#
# =============================================================================


sru["Date"] = pd.to_datetime(
    sru["Date"]
)


sru_monthly = (
    sru
    .set_index("Date")
    .resample("ME")
    .last()
    .reset_index()
)


sru_monthly["SRU_Return"] = (
    sru_monthly["Close"]
    .pct_change()
    * 100
)


sru_monthly = sru_monthly[
    [
        "Date",
        "Close",
        "SRU_Return"
    ]
]


sru_monthly = sru_monthly.dropna()


print("\nSmartCentres Monthly Returns:")

print(
    sru_monthly.tail()
)


# =============================================================================
# 5. PREPARE INTEREST RATE DATA
# =============================================================================


interest_macro = interest_monthly.copy()


interest_macro["Date"] = pd.to_datetime(
    interest_macro["Date"]
)


interest_macro = (
    interest_macro
    .set_index("Date")
    .resample("ME")
    .last()
    .reset_index()
)


interest_macro = interest_macro[
    [
        "Date",
        "Interest_Rate"
    ]
]


# =============================================================================
# 6. PREPARE INFLATION DATA
# =============================================================================


inflation_macro = inflation_df.copy()


inflation_macro["Date"] = pd.to_datetime(
    inflation_macro["Date"]
)


inflation_macro = (
    inflation_macro
    .set_index("Date")
    .resample("ME")
    .last()
    .reset_index()
)


inflation_macro = inflation_macro[
    [
        "Date",
        "Inflation_Rate"
    ]
]


# =============================================================================
# 7. PREPARE UNEMPLOYMENT DATA
# =============================================================================


unemployment_macro = unemployment_df.copy()


unemployment_macro["Date"] = pd.to_datetime(
    unemployment_macro["Date"]
)


unemployment_macro = (
    unemployment_macro
    .set_index("Date")
    .resample("ME")
    .last()
    .reset_index()
)


unemployment_macro = unemployment_macro[
    [
        "Date",
        "Unemployment_Rate"
    ]
]


# =============================================================================
# 8. PREPARE GDP DATA
# =============================================================================
#
# GDP data are usually quarterly.
#
# We forward-fill the latest available GDP growth value across the months
# within the quarter so that the data can be merged with monthly returns.
#
# =============================================================================


gdp_macro = gdp_df.copy()


gdp_macro["Date"] = pd.to_datetime(
    gdp_macro["Date"]
)


gdp_macro = (
    gdp_macro
    .set_index("Date")
    .resample("ME")
    .ffill()
    .reset_index()
)


gdp_macro = gdp_macro[
    [
        "Date",
        "GDP_Growth"
    ]
]


# =============================================================================
# 9. MERGE ALL MACROECONOMIC DATA
# =============================================================================


macro_data = interest_macro.merge(
    inflation_macro,
    on="Date",
    how="outer"
)


macro_data = macro_data.merge(
    unemployment_macro,
    on="Date",
    how="outer"
)


macro_data = macro_data.merge(
    gdp_macro,
    on="Date",
    how="outer"
)


macro_data = macro_data.sort_values(
    "Date"
)


# Forward fill macroeconomic values

macro_columns = [
    "Interest_Rate",
    "Inflation_Rate",
    "GDP_Growth",
    "Unemployment_Rate"
]


macro_data[macro_columns] = (
    macro_data[macro_columns]
    .ffill()
)


print("\nCombined Macroeconomic Data:")

print(
    macro_data.tail()
)


# =============================================================================
# 10. MERGE SMARTCENTRES RETURNS WITH MACROECONOMIC DATA
# =============================================================================


analysis_df = sru_monthly.merge(
    macro_data,
    on="Date",
    how="inner"
)


analysis_df = analysis_df.dropna(
    subset=[
        "SRU_Return",
        "Interest_Rate",
        "Inflation_Rate",
        "GDP_Growth",
        "Unemployment_Rate"
    ]
)


print("\nFinal Correlation Dataset:")

print(
    analysis_df.head()
)


print(
    "\nNumber of Observations:",
    len(analysis_df)
)


# =============================================================================
# 11. CALCULATE PEARSON CORRELATION MATRIX
# =============================================================================


correlation_columns = [
    "SRU_Return",
    "Interest_Rate",
    "Inflation_Rate",
    "GDP_Growth",
    "Unemployment_Rate"
]


correlation_matrix = analysis_df[
    correlation_columns
].corr()


print("\n" + "=" * 80)

print(
    "PEARSON CORRELATION MATRIX"
)

print("=" * 80)


print(
    correlation_matrix.round(3)
)


# =============================================================================
# 12. EXTRACT CORRELATIONS WITH SMARTCENTRES RETURNS
# =============================================================================


sru_correlations = (
    correlation_matrix[
        "SRU_Return"
    ]
    .drop(
        "SRU_Return"
    )
    .sort_values(
        key=abs,
        ascending=False
    )
)


print("\n" + "=" * 80)

print(
    "CORRELATION WITH SMARTCENTRES MONTHLY RETURNS"
)

print("=" * 80)


print(
    sru_correlations.round(3)
)


# =============================================================================
# 13. INTERPRET CORRELATION STRENGTH
# =============================================================================


def interpret_correlation(r):

    absolute_r = abs(r)


    if absolute_r >= 0.7:

        strength = "Strong"


    elif absolute_r >= 0.4:

        strength = "Moderate"


    elif absolute_r >= 0.2:

        strength = "Weak"


    else:

        strength = "Very Weak"


    if r > 0:

        direction = "Positive"


    elif r < 0:

        direction = "Negative"


    else:

        direction = "No"


    return strength, direction


# =============================================================================
# 14. CREATE CORRELATION FINDINGS
# =============================================================================


findings = []


for variable, correlation in sru_correlations.items():


    strength, direction = interpret_correlation(
        correlation
    )


    findings.append(
        {
            "Macroeconomic_Factor":
                variable,

            "Correlation_with_SRU_Return":
                correlation,

            "Strength":
                strength,

            "Direction":
                direction
        }
    )


findings_df = pd.DataFrame(
    findings
)


print("\nCorrelation Findings:")


print(
    findings_df.round(3)
)


# =============================================================================
# 15. AUTOMATIC INTERPRETATION
# =============================================================================


print("\n" + "=" * 80)

print(
    "AUTOMATIC CORRELATION INTERPRETATION"
)

print("=" * 80)


factor_names = {

    "Interest_Rate":
        "Interest Rate",

    "Inflation_Rate":
        "Inflation",

    "GDP_Growth":
        "GDP Growth",

    "Unemployment_Rate":
        "Unemployment Rate"

}


for variable, correlation in sru_correlations.items():


    strength, direction = interpret_correlation(
        correlation
    )


    factor = factor_names.get(
        variable,
        variable
    )


    print(
        f"\n{factor}"
    )


    print(
        f"Correlation: {correlation:.3f}"
    )


    print(
        f"Relationship: "
        f"{strength} {direction}"
    )


    if correlation < 0:

        print(
            f"Interpretation: Higher {factor.lower()} "
            f"tends to be associated with lower "
            f"SmartCentres monthly returns."
        )


    elif correlation > 0:

        print(
            f"Interpretation: Higher {factor.lower()} "
            f"tends to be associated with higher "
            f"SmartCentres monthly returns."
        )


    else:

        print(
            "Interpretation: No linear relationship "
            "was detected."
        )


# =============================================================================
# 16. IDENTIFY STRONGEST MACROECONOMIC RELATIONSHIP
# =============================================================================


if not sru_correlations.empty:


    strongest_factor = (
        sru_correlations
        .abs()
        .idxmax()
    )


    strongest_correlation = (
        sru_correlations[
            strongest_factor
        ]
    )


    strongest_strength, strongest_direction = (
        interpret_correlation(
            strongest_correlation
        )
    )


    print("\n" + "=" * 80)

    print(
        "KEY FINDING"
    )

    print("=" * 80)


    print(
        f"The macroeconomic factor with the strongest "
        f"linear relationship with SmartCentres monthly "
        f"returns is "
        f"{factor_names.get(strongest_factor, strongest_factor)}."
    )


    print(
        f"Correlation coefficient: "
        f"{strongest_correlation:.3f}"
    )


    print(
        f"Relationship: "
        f"{strongest_strength} "
        f"{strongest_direction}"
    )


# =============================================================================
# 17. CREATE CORRELATION HEATMAP
# =============================================================================
#
# This creates a correlation matrix visualization without seaborn.
#
# =============================================================================


fig, ax = plt.subplots(
    figsize=(9, 7)
)


heatmap = ax.imshow(
    correlation_matrix.values,
    aspect="auto"
)


ax.set_xticks(
    range(
        len(correlation_columns)
    )
)


ax.set_yticks(
    range(
        len(correlation_columns)
    )
)


display_labels = [
    "SRU Return",
    "Interest Rate",
    "Inflation",
    "GDP Growth",
    "Unemployment"
]


