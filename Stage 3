# =============================================================================
# 3. HELPER FUNCTIONS
# =============================================================================

def safe_numeric(series):
    """
    Convert a pandas Series to numeric values.
    Invalid values are converted to NaN.
    """
    return pd.to_numeric(series, errors="coerce")


def save_chart(filename):
    """
    Save the current matplotlib figure.
    """
    filepath = OUTPUT_DIR / filename
    plt.tight_layout()
    plt.savefig(filepath, dpi=300, bbox_inches="tight")
    plt.show()
    plt.close()

    print(f"Saved chart: {filepath}")


def print_section(title):
    """
    Print formatted section header.
    """
    print("\n" + "=" * 80)
    print(title)
    print("=" * 80)


# =============================================================================
# 4. BANK OF CANADA — POLICY INTEREST RATE
# =============================================================================

print_section("1. DOWNLOADING BANK OF CANADA POLICY INTEREST RATE")

# Bank of Canada Valet API
#
# V39079 = Bank Rate / policy-related interest rate series.
#
# Depending on the exact definition required by the project,
# this series can be replaced with another Bank of Canada series.

BOC_SERIES = "V39079"

BOC_URL = (
    f"https://www.bankofcanada.ca/valet/observations/"
    f"{BOC_SERIES}/json"
    f"?start_date={START_DATE}"
    f"&end_date={END_DATE}"
)

try:

    response = requests.get(BOC_URL, timeout=30)
    response.raise_for_status()

    data = response.json()

    observations = data.get("observations", [])

    interest_records = []

    for obs in observations:

        date = obs.get("d")

        value_info = obs.get(BOC_SERIES, {})

        value = value_info.get("v")

        if value is not None:

            interest_records.append(
                {
                    "Date": date,
                    "Interest_Rate": value
                }
            )

    interest_df = pd.DataFrame(interest_records)

    interest_df["Date"] = pd.to_datetime(
        interest_df["Date"]
    )

    interest_df["Interest_Rate"] = safe_numeric(
        interest_df["Interest_Rate"]
    )

    interest_df = interest_df.dropna()

    interest_df = interest_df.sort_values("Date")

    print("\nInterest Rate Data Preview:")
    print(interest_df.head())

    print("\nLatest Interest Rate Observation:")
    print(interest_df.tail(1))

except Exception as e:

    print("\nERROR downloading Bank of Canada data:")
    print(e)

    interest_df = pd.DataFrame(
        columns=[
            "Date",
            "Interest_Rate"
        ]
    )


# =============================================================================
# 5. STATISTICS CANADA DATA
# =============================================================================
#
# Statistics Canada provides many economic series.
#
# The easiest reproducible approach is to use official StatsCan vector data.
#
# IMPORTANT:
# Vector IDs should be verified against Statistics Canada before final
# submission because StatsCan contains multiple CPI, GDP, and labour-market
# definitions.
#
# The function below downloads a vector from the Statistics Canada Web Data
# Service.
#
# =============================================================================


def download_statscan_vector(vector_id, variable_name):
    """
    Download a Statistics Canada data vector using the official
    Web Data Service.

    Parameters
    ----------
    vector_id : str
        Statistics Canada vector number.

    variable_name : str
        Desired output column name.

    Returns
    -------
    pandas.DataFrame
        DataFrame containing Date and variable.
    """

    print(
        f"\nDownloading StatsCan vector "
        f"{vector_id} for {variable_name}..."
    )

    url = (
        "https://www150.statcan.gc.ca/"
        "t1/wds/rest/getFullTableDownloadCSV/"
        f"{vector_id}/en"
    )

    try:

        response = requests.get(
            url,
            timeout=60
        )

        response.raise_for_status()

        print(
            "StatsCan request completed."
        )

        return None

    except Exception as e:

        print(
            f"Could not automatically download "
            f"{variable_name}: {e}"
        )

        return None


# =============================================================================
# 6. ALTERNATIVE MACRO DATA USING FRED CSV API
# =============================================================================
#
# For easier reproducibility in a classroom environment, the following
# section uses FRED-hosted macroeconomic series.
#
# FRED republishes economic data from official statistical agencies.
#
# No API key is required when using the CSV download endpoint.
#
# Series used:
#
# CPALTT01CAM659N
#   Canada Consumer Price Index — percentage change
#
# NGDPRSAXDCCAQ
#   Canada Real GDP
#
# LRUNTTTTCAM156S
#   Canada Unemployment Rate
#
# =============================================================================


def download_fred_series(series_id, column_name):
    """
    Download a FRED series using the public CSV endpoint.
    """

    print(
        f"\nDownloading {column_name}..."
    )

    url = (
        "https://fred.stlouisfed.org/"
        "graph/fredgraph.csv"
        f"?id={series_id}"
    )

    try:

        df = pd.read_csv(url)

        df.columns = [
            "Date",
            column_name
        ]

        df["Date"] = pd.to_datetime(
            df["Date"]
        )

        df[column_name] = safe_numeric(
            df[column_name]
        )

        df = df.dropna()

        df = df[
            df["Date"] >= pd.to_datetime(
                START_DATE
            )
        ]

        df = df[
            df["Date"] <= pd.to_datetime(
                END_DATE
            )
        ]

        df = df.sort_values(
            "Date"
        )

        print(
            f"{column_name} downloaded successfully."
        )

        print(
            df.tail()
        )

        return df

    except Exception as e:

        print(
            f"ERROR downloading {column_name}:"
        )

        print(e)

        return pd.DataFrame(
            columns=[
                "Date",
                column_name
            ]
        )


