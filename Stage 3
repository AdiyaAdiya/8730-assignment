# =============================================================================
# 12. DESCRIPTIVE STATISTICS
# =============================================================================

print_section("6. DESCRIPTIVE STATISTICS")

statistics = []


def add_statistics(df, column, indicator):

    if df.empty:
        return

    statistics.append(
        {
            "Indicator": indicator,

            "Mean":
                df[column].mean(),

            "Median":
                df[column].median(),

            "Minimum":
                df[column].min(),

            "Maximum":
                df[column].max(),

            "Standard_Deviation":
                df[column].std(),

            "Latest":
                df[column].iloc[-1]
        }
    )


add_statistics(
    interest_monthly,
    "Interest_Rate",
    "Interest Rate"
)

add_statistics(
    inflation_df,
    "Inflation_Rate",
    "Inflation Rate"
)

add_statistics(
    gdp_df,
    "GDP_Growth",
    "GDP Growth"
)

add_statistics(
    unemployment_df,
    "Unemployment_Rate",
    "Unemployment Rate"
)


statistics_df = pd.DataFrame(
    statistics
)


print(
    statistics_df.round(2)
)


statistics_df.to_csv(
    OUTPUT_DIR /
    "canada_macro_descriptive_statistics.csv",
    index=False
)


# =============================================================================
# 13. INTEREST RATE TREND
# =============================================================================

print_section("7. CREATING VISUALIZATIONS")


if not interest_monthly.empty:

    plt.figure(
        figsize=(12, 6)
    )

    plt.plot(
        interest_monthly["Date"],
